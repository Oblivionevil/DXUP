<!-- Colors of the dark theme; same keys as Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Ground" Color="#1C1C1C" />
  <SolidColorBrush x:Key="Panel" Color="#272727" />
  <SolidColorBrush x:Key="Line" Color="#3A3A3A" />
  <SolidColorBrush x:Key="Text" Color="#EDEDED" />
  <SolidColorBrush x:Key="Muted" Color="#A3A3A3" />
  <SolidColorBrush x:Key="Accent" Color="#3B82D6" />
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Header" Color="#17263F" />
  <SolidColorBrush x:Key="HeaderText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HeaderMuted" Color="#8FB0DA" />
  <SolidColorBrush x:Key="Control" Color="#323232" />
  <SolidColorBrush x:Key="ControlBorder" Color="#4A4A4A" />
  <SolidColorBrush x:Key="ControlHover" Color="#3B3B3B" />
  <SolidColorBrush x:Key="Selection" Color="#24405F" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#5A5A5A" />
  <SolidColorBrush x:Key="WarnBack" Color="#3A2E16" />
  <SolidColorBrush x:Key="WarnBorder" Color="#8A6A2A" />
  <SolidColorBrush x:Key="InfoBack" Color="#1A2A40" />
  <SolidColorBrush x:Key="InfoBorder" Color="#2E4A6E" />
  <SolidColorBrush x:Key="InfoText" Color="#A9C6EC" />
  <SolidColorBrush x:Key="Good" Color="#38A169" />
  <SolidColorBrush x:Key="Warn" Color="#C58A2A" />
  <SolidColorBrush x:Key="Bad" Color="#E05252" />
  <SolidColorBrush x:Key="Neutral" Color="#6B7280" />
</ResourceDictionary>
