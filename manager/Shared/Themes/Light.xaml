<!-- Colors of the light theme; Dark.xaml has the same keys. Styles and windows use them as DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Ground" Color="#F2F4F7" />
  <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Line" Color="#D9DEE5" />
  <SolidColorBrush x:Key="Text" Color="#1A202C" />
  <SolidColorBrush x:Key="Muted" Color="#5F6B7A" />
  <SolidColorBrush x:Key="Accent" Color="#2B6CB0" />
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Header" Color="#1E4078" />
  <SolidColorBrush x:Key="HeaderText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HeaderMuted" Color="#A9C6EC" />
  <SolidColorBrush x:Key="Control" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ControlBorder" Color="#C9D1DB" />
  <SolidColorBrush x:Key="ControlHover" Color="#EEF3F9" />
  <SolidColorBrush x:Key="Selection" Color="#DCE9F8" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#B8C2CE" />
  <SolidColorBrush x:Key="WarnBack" Color="#FFF4E5" />
  <SolidColorBrush x:Key="WarnBorder" Color="#F6C77E" />
  <SolidColorBrush x:Key="InfoBack" Color="#EBF4FF" />
  <SolidColorBrush x:Key="InfoBorder" Color="#A3C4F3" />
  <SolidColorBrush x:Key="InfoText" Color="#1E4078" />
  <SolidColorBrush x:Key="Good" Color="#2F855A" />
  <SolidColorBrush x:Key="Warn" Color="#B7791F" />
  <SolidColorBrush x:Key="Bad" Color="#C53030" />
  <SolidColorBrush x:Key="Neutral" Color="#718096" />
</ResourceDictionary>
