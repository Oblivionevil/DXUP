<Window x:Class="Dxup.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXUP Setup" Width="640" Height="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Ground}" Foreground="{DynamicResource Text}" Icon="dxup.ico">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource Header}" Padding="24,18">
      <DockPanel>
        <ContentControl Style="{StaticResource Logo}" Width="46" Height="46" Margin="0,0,14,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Foreground="{DynamicResource HeaderText}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource HeaderMuted}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="24,20">
      <!-- Options (install / upgrade) -->
      <StackPanel x:Name="OptionsPage">
        <TextBlock Text="{DynamicResource Welcome}" TextWrapping="Wrap" />
        <TextBlock x:Name="UpgradeText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Accent}" Visibility="Collapsed" />
        <TextBlock Text="{DynamicResource InstallTo}" FontWeight="SemiBold" Margin="0,20,0,6" />
        <DockPanel>
          <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="{DynamicResource Browse}" Margin="8,0,0,0" Click="OnBrowse" />
          <TextBox x:Name="DirBox" Padding="4,5" VerticalContentAlignment="Center" />
        </DockPanel>
        <CheckBox x:Name="DesktopBox" Content="{DynamicResource DesktopShortcut}" Margin="0,16,0,0" />
      </StackPanel>

      <!-- Uninstall confirmation -->
      <StackPanel x:Name="UninstallPage" Visibility="Collapsed">
        <TextBlock Text="{DynamicResource UninstallInfo}" TextWrapping="Wrap" />
        <CheckBox x:Name="KeepBox" Content="{DynamicResource KeepSettings}" Margin="0,16,0,0" />
      </StackPanel>

      <!-- Progress and result -->
      <DockPanel x:Name="ProgressPage" Visibility="Collapsed">
        <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Height="6" Maximum="100" Margin="0,0,0,14" />
        <CheckBox x:Name="StartBox" DockPanel.Dock="Bottom" Content="{DynamicResource StartManager}" IsChecked="True"
                  Margin="0,12,0,0" Visibility="Collapsed" />
        <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" />
      </DockPanel>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="{DynamicResource Cancel}" Click="OnCancel" />
        <Button x:Name="MainButton" Style="{StaticResource AccentButton}" Margin="0" Click="OnMain" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
