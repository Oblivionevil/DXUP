<Window x:Class="Dxup.Manager.FinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FindTitle}" Width="920" Height="560" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ground}" Foreground="{DynamicResource Text}" ShowInTaskbar="False">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,10" HorizontalAlignment="Left" Width="360">
      <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" IsEnabled="False" AutomationProperties.Name="{DynamicResource Search}" />
      <TextBlock x:Name="SearchHint" Text="{DynamicResource Search}" Foreground="{DynamicResource Muted}" Margin="7,0,0,0"
                 VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <ListView x:Name="GameList" BorderThickness="0" HorizontalContentAlignment="Stretch">
          <ListView.View>
            <GridView>
              <GridViewColumn Width="36">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Available}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="{DynamicResource ColGame}" Width="290">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Muted}" FontSize="11" />
                    </StackPanel>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="{DynamicResource ColSource}" Width="100">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Store}" Foreground="{DynamicResource Muted}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="{DynamicResource ColExe}" Width="420">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding Executables}" SelectedItem="{Binding Executable, Mode=TwoWay}"
                              DisplayMemberPath="Text" Width="400" IsEnabled="{Binding Available}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
        <TextBlock x:Name="InfoText" Text="{DynamicResource FindSearching}" Foreground="{DynamicResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="{DynamicResource Cancel}" IsCancel="True" />
      <Button x:Name="AddButton" Content="{DynamicResource FindAdd}" Style="{StaticResource AccentButton}" Margin="0"
              Click="OnAdd" IsDefault="True" IsEnabled="False" />
    </StackPanel>
  </Grid>
</Window>
