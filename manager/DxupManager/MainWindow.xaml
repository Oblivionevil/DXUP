<Window x:Class="Dxup.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXUP Manager" Width="1060" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Ground}" Foreground="{DynamicResource Text}"
        Icon="dxup.ico">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource Header}" Padding="20,14">
      <DockPanel LastChildFill="False">
        <ContentControl Style="{StaticResource Logo}" Width="40" Height="40" Margin="0,0,12,0" DockPanel.Dock="Left" />
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Text="DXUP Manager" Foreground="{DynamicResource HeaderText}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="VersionText" Foreground="{DynamicResource HeaderMuted}" FontSize="12" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="FindButton" Content="{DynamicResource Autofind}" Click="OnFind" Style="{StaticResource HeaderButton}" />
          <Button x:Name="AddButton" Content="{DynamicResource AddGame}" Click="OnAdd" Style="{StaticResource AccentButton}" Margin="0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Banners -->
    <StackPanel Grid.Row="1">
      <Border x:Name="NotInstalledBanner" Background="{DynamicResource WarnBack}" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="0,0,0,1" Padding="20,8" Visibility="Collapsed">
        <TextBlock Text="{DynamicResource WarnNotInstalled}" TextWrapping="Wrap" />
      </Border>
      <Border x:Name="OutdatedBanner" Background="{DynamicResource InfoBack}" BorderBrush="{DynamicResource InfoBorder}" BorderThickness="0,0,0,1" Padding="20,8" Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{DynamicResource UpdateAll}" Click="OnUpdateAll" Margin="0" />
          <TextBlock x:Name="OutdatedText" VerticalAlignment="Center" Foreground="{DynamicResource InfoText}" />
        </DockPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="2" Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Game list -->
      <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ListBox x:Name="GameList" SelectionChanged="OnSelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Dir}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="2" Background="{Binding StateBrush}" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateText}" Foreground="White" FontSize="11" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyText" Text="{DynamicResource NoGames}" TextWrapping="Wrap" Margin="24" Foreground="{DynamicResource Muted}"
                     VerticalAlignment="Center" TextAlignment="Center" />
          <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10">
            <Button x:Name="RemoveButton" Content="{DynamicResource RemoveGame}" Click="OnRemove" HorizontalAlignment="Left" IsEnabled="False" />
          </Border>
        </Grid>
      </Border>

      <!-- Settings of the selected game -->
      <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <TextBlock x:Name="SelectText" Text="{DynamicResource SelectGame}" Foreground="{DynamicResource Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="22,18">
              <DockPanel>
                <Image x:Name="DetailIcon" Width="48" Height="48" Margin="0,0,14,0" DockPanel.Dock="Left" VerticalAlignment="Top" />
                <StackPanel>
                  <TextBox x:Name="NameBox" FontSize="18" FontWeight="SemiBold" BorderThickness="0,0,0,1" Padding="0,2" Background="Transparent"
                           LostFocus="OnNameChanged" KeyDown="OnNameKeyDown" />
                  <TextBlock x:Name="ExeText" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Border x:Name="StateBadge" CornerRadius="10" Padding="10,2" Margin="0,0,12,0" VerticalAlignment="Center">
                      <TextBlock x:Name="StateText" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                    <Button x:Name="ToggleButton" Click="OnToggle" Style="{StaticResource AccentButton}" />
                    <Button x:Name="FixButton" Click="OnFix" Visibility="Collapsed" />
                    <Button Content="{DynamicResource OpenFolder}" Click="OnOpenFolder" />
                  </StackPanel>
                </StackPanel>
              </DockPanel>

              <StackPanel x:Name="Warnings" Margin="0,12,0,0" />

              <TextBlock Text="{DynamicResource SectionTextures}" Style="{StaticResource Section}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="230" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Anisotropy}" Style="{StaticResource Caption}" />
                <ComboBox x:Name="AnisotropyBox" Grid.Column="1" HorizontalAlignment="Left" DisplayMemberPath="Text" SelectionChanged="OnSettingChanged" />
                <TextBlock Grid.Row="1" Text="{DynamicResource LodBias}" Style="{StaticResource Caption}" Margin="0,10,12,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                  <Slider x:Name="LodSlider" Width="200" Minimum="-2" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True"
                          VerticalAlignment="Center" ValueChanged="OnLodChanged" />
                  <TextBlock x:Name="LodText" Width="110" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <TextBlock Text="{DynamicResource SectionAa}" Style="{StaticResource Section}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="230" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource MsaaSamples}" Style="{StaticResource Caption}" />
                <ComboBox x:Name="MsaaBox" Grid.Column="1" HorizontalAlignment="Left" DisplayMemberPath="Text" SelectionChanged="OnSettingChanged" />
                <CheckBox x:Name="ForceBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Click="OnSettingChanged">
                  <TextBlock Text="{DynamicResource MsaaForce}" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Grid.Row="2" Text="{DynamicResource MsaaScope}" Style="{StaticResource Caption}" Margin="0,10,12,0" />
                <ComboBox x:Name="ScopeBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="0,10,0,0" DisplayMemberPath="Text" SelectionChanged="OnSettingChanged" />
                <TextBlock Grid.Row="3" Text="{DynamicResource Sgssaa}" Style="{StaticResource Caption}" Margin="0,10,12,0" />
                <ComboBox x:Name="SgssaaBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="0,10,0,0" DisplayMemberPath="Text" SelectionChanged="OnSettingChanged" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource SgssaaHint}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" />
                <TextBlock x:Name="UpscalerCaption" Grid.Row="5" Text="{DynamicResource Upscaler}" Style="{StaticResource Caption}" Margin="0,10,12,0" />
                <ComboBox x:Name="UpscalerBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Margin="0,10,0,0" DisplayMemberPath="Text" SelectionChanged="OnSettingChanged" />
                <TextBlock x:Name="UpscalerHintText" Grid.Row="6" Grid.Column="1" Text="{DynamicResource UpscalerHint}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                <CheckBox x:Name="UpscalerAutoBox" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" Click="OnSettingChanged">
                  <TextBlock Text="{DynamicResource UpscalerAuto}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox x:Name="UpscalerInjectBox" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Click="OnSettingChanged">
                  <TextBlock Text="{DynamicResource UpscalerInject}" TextWrapping="Wrap" />
                </CheckBox>
              </Grid>

              <TextBlock Text="{DynamicResource SectionDisplay}" Style="{StaticResource Section}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="230" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource VSync}" Style="{StaticResource Caption}" />
                <ComboBox x:Name="VSyncBox" Grid.Column="1" HorizontalAlignment="Left" DisplayMemberPath="Text" SelectionChanged="OnSettingChanged" />
                <TextBlock Grid.Row="1" Text="{DynamicResource Frames}" Style="{StaticResource Caption}" Margin="0,10,12,0" />
                <ComboBox x:Name="FramesBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="0,10,0,0" DisplayMemberPath="Text" SelectionChanged="OnSettingChanged" />
                <CheckBox x:Name="SpatialBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Click="OnSettingChanged">
                  <TextBlock Text="{DynamicResource SpatialUpscale}" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Grid.Row="3" Text="{DynamicResource RenderScale}" Style="{StaticResource Caption}" Margin="0,10,12,0" />
                <ComboBox x:Name="RenderScaleBox" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="0,10,0,0" DisplayMemberPath="Text" SelectionChanged="OnSettingChanged" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource RenderScaleHint}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Grid.Row="5" Text="{DynamicResource Adapter}" Style="{StaticResource Caption}" Margin="0,10,12,0" />
                <ComboBox x:Name="AdapterBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Margin="0,10,0,0" DisplayMemberPath="Text" SelectionChanged="OnSettingChanged" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{DynamicResource AdapterHint}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
              </Grid>

              <TextBlock Text="{DynamicResource SectionShaders}" Style="{StaticResource Section}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="230" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Precompile}" Style="{StaticResource Caption}" />
                <CheckBox x:Name="PrecompileBox" Grid.Column="1" Click="OnSettingChanged">
                  <TextBlock Text="{DynamicResource PrecompileOn}" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource PrecompileHint}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="{DynamicResource AsyncShaders}" Style="{StaticResource Caption}" Margin="0,10,12,0" />
                <CheckBox x:Name="AsyncBox" Grid.Row="2" Grid.Column="1" Click="OnSettingChanged" Margin="0,10,0,0">
                  <TextBlock Text="{DynamicResource AsyncOn}" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource AsyncHint}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
              </Grid>

              <TextBlock Text="{DynamicResource SectionDiagnostics}" Style="{StaticResource Section}" />
              <TextBlock Text="{DynamicResource DiagIntro}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />
              <StackPanel x:Name="DiagSwitches" Margin="0,8,0,0">
                <CheckBox x:Name="DiagLogBox" Tag="dxup_info_log.txt" Checked="OnDiagChanged" Unchecked="OnDiagChanged" Margin="0,0,0,6">
                  <TextBlock Text="{DynamicResource DiagLog}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox x:Name="DiagLayerBox" Tag="dxup_debug.txt" Checked="OnDiagChanged" Unchecked="OnDiagChanged" Margin="0,0,0,6">
                  <TextBlock Text="{DynamicResource DiagLayer}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox x:Name="DiagGpuBox" Tag="dxup_gpu_validation.txt" Checked="OnDiagChanged" Unchecked="OnDiagChanged" Margin="20,0,0,6">
                  <TextBlock Text="{DynamicResource DiagGpu}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox x:Name="DiagDredBox" Tag="dxup_dred.txt" Checked="OnDiagChanged" Unchecked="OnDiagChanged" Margin="0,0,0,6">
                  <TextBlock Text="{DynamicResource DiagDred}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox x:Name="DiagExceptionsBox" Tag="dxup_exception_trace.txt" Checked="OnDiagChanged" Unchecked="OnDiagChanged" Margin="0,0,0,6">
                  <TextBlock Text="{DynamicResource DiagExceptions}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox x:Name="DiagFramesBox" Tag="dxup_frame_dump.txt" Checked="OnDiagChanged" Unchecked="OnDiagChanged" Margin="0,0,0,6">
                  <TextBlock Text="{DynamicResource DiagFrames}" TextWrapping="Wrap" />
                </CheckBox>
              </StackPanel>
              <TextBlock x:Name="DiagLayerMissing" Text="{DynamicResource DiagLayerMissing}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
              <TextBlock x:Name="DiagInactive" Text="{DynamicResource DiagInactive}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
              <WrapPanel Margin="0,10,0,0">
                <Button Content="{DynamicResource DiagPackage}" Click="OnDiagPackage" Margin="0,0,8,8" />
                <Button Content="{DynamicResource DiagOpenFolder}" Click="OnOpenFolder" Margin="0,0,8,8" />
                <Button x:Name="RenderDocButton" Click="OnRenderDoc" Margin="0,0,8,8" />
                <Button x:Name="PixButton" Click="OnPix" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="{DynamicResource DiagGpuDebuggers}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" />

              <TextBlock Text="{DynamicResource AppliesNextStart}" Foreground="{DynamicResource Muted}" Margin="0,22,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Status line -->
    <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
      <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" />
    </Border>
  </Grid>
</Window>
